# Supabase Dashboard -> Connect -> App Frameworks -> Next.js
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy Supabase projects may show an anon key instead of a publishable key.
# Leave this blank when NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is set.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Calendar dates use this household-local timezone. Defaults to America/Chicago.
HOUSEHOLD_TIME_ZONE=America/Chicago

# Never place a service-role or secret key in a NEXT_PUBLIC_* variable.
